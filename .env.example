# Compose reads this file. Native Python needs these exported in the shell.
POSTGRES_PASSWORD=local-development-password
AUTH_SECRET=development-only-change-this-secret-32-characters
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEMO_ENABLED=true
# For native setup only; Compose supplies its own PostgreSQL URL.
DATABASE_URL=sqlite:///./closetwise.db
API_INTERNAL_URL=http://127.0.0.1:8000
STORAGE_PATH=./data/images
STORAGE_BACKEND=local
RECOGNITION_PROVIDER=mock
# Optional server-side vision. Failure falls back to manual review.
VISION_API_KEY=
VISION_MODEL=gpt-4.1-mini
VISION_URL=https://api.openai.com/v1/chat/completions
# Optional private S3-compatible bucket. No public object URLs are used.
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

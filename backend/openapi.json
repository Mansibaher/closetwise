  "components": {
    "schemas": {
      "AdjustmentInput": {
        "properties": {
          "direction": {
            "type": "string",
            "enum": [
              "warmer",
              "cooler",
              "casual",
              "formal"
            ],
            "title": "Direction"
          }
        },
        "type": "object",
        "required": [
          "direction"
        ],
        "title": "AdjustmentInput"
      },
      "AdjustmentView": {
        "properties": {
          "outfit": {
            "$ref": "#/components/schemas/OutfitView"
          },
          "original_id": {
            "type": "string",
            "title": "Original Id"
          },
          "replacement_id": {
            "type": "string",
            "title": "Replacement Id"
          },
          "direction": {
            "type": "string",
            "title": "Direction"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          }
        },
        "type": "object",
        "required": [
          "outfit",
          "original_id",
          "replacement_id",
          "direction",
          "explanation"
        ],
        "title": "AdjustmentView"
      },
      "AnalysisView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "proposed": {
            "$ref": "#/components/schemas/Attributes"
          },
          "uncertainty": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Uncertainty"
          },
          "warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Warning"
          },
          "image_url": {
            "type": "string",
            "title": "Image Url"
          }
        },
        "type": "object",
        "required": [
          "id",
          "provider",
          "proposed",
          "uncertainty",
          "warning",
          "image_url"
        ],
        "title": "AnalysisView"
      },
      "ArchiveInput": {
        "properties": {
          "archived": {
            "type": "boolean",
            "title": "Archived"
          }
        },
        "type": "object",
        "required": [
          "archived"
        ],
        "title": "ArchiveInput"
      },
      "Attributes": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "category": {
            "type": "string",
            "enum": [
              "shirt",
              "knit",
              "trousers",
              "skirt",
              "jeans",
              "dress",
              "jumpsuit",
              "sneakers",
              "loafers",
              "dress_shoes",
              "boots",
              "coat",
              "jacket",
              "scarf",
              "bag"
            ],
            "title": "Category"
          },
          "slot": {
            "type": "string",
            "enum": [
              "top",
              "bottom",
              "shoes",
              "onepiece",
              "outerwear",
              "accessory"
            ],
            "title": "Slot"
          },
          "audience": {
            "type": "string",
            "enum": [
              "men",
              "women",
              "unisex"
            ],
            "title": "Audience",
            "default": "unisex"
          },
          "primary_color": {
            "type": "string",
            "enum": [
              "black",
              "white",
              "navy",
              "gray",
              "beige",
              "brown",
              "blue",
              "green",
              "red",
              "pink",
              "purple",
              "yellow"
            ],
            "title": "Primary Color"
          },
          "secondary_color": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "black",
                  "white",
                  "navy",
                  "gray",
                  "beige",
                  "brown",
                  "blue",
                  "green",
                  "red",
                  "pink",
                  "purple",
                  "yellow"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Secondary Color"
          },
          "pattern": {
            "type": "string",
            "enum": [
              "solid",
              "striped",
              "checked",
              "floral",
              "graphic"
            ],
            "title": "Pattern",
            "default": "solid"
          },
          "warmth": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 0.0,
            "title": "Warmth"
          },
          "formality": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 0.0,
            "title": "Formality"
          },
          "seasons": {
            "items": {
              "type": "string",
              "enum": [
                "spring",
                "summer",
                "autumn",
                "winter"
              ]
            },
            "type": "array",
            "maxItems": 4,
            "title": "Seasons"
          },
          "weather": {
            "items": {
              "type": "string",
              "enum": [
                "dry",
                "rain",
                "wind"
              ]
            },
            "type": "array",
            "maxItems": 3,
            "title": "Weather"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 12,
            "title": "Tags"
          },
          "laundry": {
            "type": "string",
            "enum": [
              "clean",
              "dirty",
              "unavailable"
            ],
            "title": "Laundry",
            "default": "clean"
          },
          "notes": {
            "type": "string",
            "maxLength": 1000,
            "title": "Notes",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "category",
          "slot",
          "primary_color",
          "warmth",
          "formality"
        ],
        "title": "Attributes"
      },
      "Body_upload_uploads_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_uploads_post"
      },
      "Context": {
        "properties": {
          "occasion": {
            "type": "string",
            "maxLength": 80,
            "title": "Occasion",
            "default": "job interview"
          },
          "temperature": {
            "type": "number",
            "maximum": 40.0,
            "minimum": -10.0,
            "title": "Temperature",
            "default": 12
          },
          "precipitation": {
            "type": "string",
            "enum": [
              "dry",
              "rain"
            ],
            "title": "Precipitation",
            "default": "dry"
          },
          "wind": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Wind",
            "default": 8
